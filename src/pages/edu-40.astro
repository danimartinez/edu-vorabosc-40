---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Countdown from '../components/Countdown';
import AddToCalendar from '../components/AddToCalendar';
import LineupSection from '../components/LineupSection.astro';
import ScheduleSection from '../components/ScheduleSection.astro';
import LocationStay from '../components/LocationStay.astro';
import LegacySection from '../components/LegacySection.astro';
import { SITE_TITLE, SITE_DESCRIPTION, EVENT_DATA } from '../consts';
---

<!doctype html>
<html lang="ca" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-slate-900 selection:bg-amber-400 selection:text-slate-950">
		<Header />

		<main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
			
			<!-- HERO SECTION -->
			<section id="inici" class="pt-6 sm:pt-12 pb-16 sm:pb-24 text-center relative">
				
				<!-- Ambient background glow behind Hero -->
				<div class="absolute -top-10 left-1/2 -translate-x-1/2 w-72 sm:w-[520px] h-72 sm:h-[420px] bg-gradient-to-tr from-amber-300/20 via-sky-300/20 to-amber-200/15 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

				<!-- Festival Badge Logo Banner -->
				<div class="max-w-md sm:max-w-lg mx-auto mb-8 relative group">
					<div class="absolute -inset-1 bg-gradient-to-r from-amber-300 via-amber-400 to-sky-300 rounded-3xl blur-md opacity-40 group-hover:opacity-70 transition duration-500"></div>
					<div class="relative rounded-3xl overflow-hidden glass-card border border-slate-200/80 p-2 sm:p-3 shadow-xl bg-white/90">
						<img
							src="/logo/vorabosc-banner.jpg"
							alt="Vörabosc Logotip Oficial"
							class="w-full h-auto rounded-2xl object-cover"
						/>
					</div>
				</div>

				<!-- Date Display -->
				<h2 class="text-3xl sm:text-5xl md:text-6xl font-bold text-slate-900 font-heading tracking-wide mb-6">
					19 DE JUNY DEL 2027
				</h2>

				<!-- Text Invitació / Una celebració de vida -->
				<div class="max-w-2xl mx-auto mb-10 text-center space-y-4 px-2">
					<h3 class="text-2xl sm:text-3xl font-heading tracking-wide text-slate-900">
						Una celebració de vida
					</h3>

					<h4 class="text-lg sm:text-xl font-bold text-amber-600 font-body italic">
						"No em caso, però no cada dia es fan 40 anys..."
					</h4>

					<p class="text-slate-700 text-sm sm:text-base leading-relaxed">
						Al cap i a la fi, com que a la vida hi som de pas, celebrem-la com cal! I la millor excusa és un dia complet amb vermut, arrossada, música en directe, berenar amb la mítica coca del mossèn per bufar espelmes i food truck per aguantar ballant fins a mitjanit.
					</p>
				</div>

				<!-- Location & Hours Quick Pill -->
				<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm font-bold text-slate-600 mb-12">
					<span class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-xs">
						📍 La Pèrgola (Carpes Vig Estiu, Vic)
					</span>
					<span class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-xs">
						⏰ 13:00 h a les 00:00 h
					</span>
					<span class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-xs">
						🎉 11 Hores de Festa Non-Stop
					</span>
				</div>

				<!-- Live Countdown Component -->
				<div class="mb-12">
					<Countdown client:load targetDate={EVENT_DATA.isoDateStart} />
				</div>

				<!-- Action Buttons (Tickets & Calendar) -->
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<AddToCalendar
						client:load
						title={EVENT_DATA.title}
						startDate={EVENT_DATA.isoDateStart}
						endDate={EVENT_DATA.isoDateEnd}
						location={EVENT_DATA.locationName + ', ' + EVENT_DATA.locationAddress}
					/>
				</div>

			</section>


			<!-- 1. FESTIVAL LINEUP (MÚSICA #musica) -->
			<LineupSection />


			<!-- 2. GASTRONOMY & SCHEDULE (GASTRONOMIA #gastronomia) -->
			<ScheduleSection />


			<!-- 3. LEGACY & NOSTALGIA (HISTÒRIA #historia) -->
			<LegacySection />


			<!-- 4. LOCATION & ACCOMMODATION (UBICACIÓ #ubicacio) -->
			<LocationStay />

		</main>

		<Footer />
	</body>
</html>


