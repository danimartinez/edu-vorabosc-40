---
interface Artist {
	name: string;
	genre: string;
	badge: string;
	badgeType: 'blue' | 'yellow' | 'dark';
	image?: string;
	imagePosition?: string;
}

const artists: Artist[] = [
	{ name: "Cat4Rabbit", genre: "Live Band / Pop-Rock", badge: "Live", badgeType: "blue" },
	{ name: "Nitro", genre: "House", badge: "DJ", badgeType: "yellow", image: "/images/artists/nitro.webp" },
	{ name: "Els Tets", genre: "Rumba", badge: "Live", badgeType: "blue", image: "/images/artists/els-tets.jpg", imagePosition: "object-top" },
	{ name: "Wagens", genre: "", badge: "DJ", badgeType: "yellow", image: "/images/artists/wagens.jpg", imagePosition: "object-top" },
	{ name: "Lacara.b", genre: "Salsa", badge: "DJ", badgeType: "yellow", image: "/images/artists/lacarab.jpg" },
	{ name: "Vito Blasu", genre: "Ritmes & Sessions", badge: "DJ", badgeType: "yellow" },
	{ name: "DJ Saraswati", genre: "Electroswing i Grooves Remix", badge: "DJ", badgeType: "yellow", image: "/images/artists/dj-saraswati.jpg" },
];
---

<section id="musica" class="py-20 px-4 sm:px-6 lg:px-8 relative">
	<!-- Ambient background glow -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl h-96 bg-gradient-to-r from-amber-300/15 via-sky-300/15 to-amber-300/15 blur-3xl -z-10 pointer-events-none"></div>

	<div class="max-w-6xl mx-auto">
		<!-- Section Header -->
		<div class="text-center mb-14">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-bold uppercase tracking-widest mb-4">
				<span>🎵 Cartell Musical</span>
			</div>
			<h2 class="text-3xl sm:text-5xl font-black text-slate-900 font-heading tracking-tight mb-4">
				El Line-Up del <span class="text-gradient-sun-sky">Vörabosc 4.0</span>
			</h2>
			<p class="text-slate-600 max-w-xl mx-auto text-base sm:text-lg">
				11 hores consecutives de música, directes i DJ sets amb una selecció de luxe pensada per ballar sense descans.
			</p>
		</div>

		<!-- Festival Poster Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
			{artists.map((artist) => (
				<div class="glass-card glass-card-hover rounded-3xl p-4 sm:p-5 relative overflow-hidden group flex flex-col justify-between">
					
					<!-- Artist Image Container -->
					<div class="w-full aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-gradient-to-br from-slate-100 to-slate-200/80 border border-slate-200/80 relative flex items-center justify-center">
						{artist.image ? (
							<img
								src={artist.image}
								alt={artist.name}
								class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ${artist.imagePosition || 'object-center'}`}
							/>
						) : (
							<div class="flex flex-col items-center justify-center text-slate-400 gap-1.5">
								<span class="text-3xl opacity-75">
									{artist.badgeType === 'blue' ? '🎸' : '🎧'}
								</span>
								<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
									Foto Artista
								</span>
							</div>
						)}
					</div>

					<!-- Badge & Details -->
					<div class="flex flex-col flex-grow justify-between">
						<!-- Left Aligned Badge -->
						<div class="mb-2">
							<span class={`inline-block px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider ${
								artist.badgeType === 'blue' 
									? 'bg-sky-50 text-sky-700 border border-sky-200' 
									: 'bg-amber-50 text-amber-700 border border-amber-200'
							}`}>
								{artist.badge}
							</span>
						</div>

						<!-- Artist Name & Genre -->
						<div>
							<h3 class="text-xl sm:text-2xl font-black font-heading text-slate-900 group-hover:text-sky-700 transition-colors mb-1">
								{artist.name}
							</h3>
							{artist.genre ? (
								<p class="text-xs sm:text-sm text-slate-500 font-semibold">
									{artist.genre}
								</p>
							) : (
								<p class="text-xs sm:text-sm text-slate-400 font-medium italic">
									DJ Set
								</p>
							)}
						</div>
					</div>

				</div>
			))}
		</div>
	</div>
</section>
