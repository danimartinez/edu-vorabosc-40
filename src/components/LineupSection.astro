---
interface Artist {
	name: string;
	genre: string;
	badge?: string;
	description?: string;
}

const artists: Artist[] = [
	{ name: "Cat4Rabbit", genre: "Live Band / Pop-Rock", badge: "Live" },
	{ name: "Dj Nitro", genre: "Indie & Electronic Beats", badge: "DJ Set" },
	{ name: "Els Tets", genre: "Festa & Hits", badge: "Live" },
	{ name: "Wagens", genre: "Rock & Grooves", badge: "Live" },
	{ name: "La Cara B", genre: "Selecció Especial & Vinils", badge: "Special Set" },
	{ name: "Vito Blasu", genre: "Ritmes & Sessions", badge: "DJ Set" },
	{ name: "DjSaraswati", genre: "Atmospheric & Dance", badge: "DJ Set" },
	{ name: "Els Pipes", genre: "Clàssics & Energy", badge: "Live" },
];
---

<section id="cartell" class="py-20 px-4 sm:px-6 lg:px-8 relative">
	<!-- Background glow -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl h-96 bg-gradient-to-r from-orange-500/10 via-amber-500/10 to-rose-500/10 blur-3xl -z-10 pointer-events-none"></div>

	<div class="max-w-5xl mx-auto">
		<!-- Section Header -->
		<div class="text-center mb-14">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/15 border border-orange-500/30 text-orange-400 text-xs font-bold uppercase tracking-widest mb-4">
				<span>🎵 Cartell Musical</span>
			</div>
			<h2 class="text-3xl sm:text-5xl font-extrabold text-white font-heading tracking-tight mb-4">
				El Line-Up del <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-400">Vörabosc 4.0</span>
			</h2>
			<p class="text-slate-300 max-w-xl mx-auto text-base sm:text-lg">
				11 hores consecutives de música, directes i DJ sets amb una selecció de luxe pensada per ballar sense descans.
			</p>
		</div>

		<!-- Festival Poster Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
			{artists.map((artist, index) => (
				<div class="glass-card glass-card-hover rounded-2xl p-6 relative overflow-hidden group border border-white/10 flex flex-col justify-between">
					<!-- Top decoration -->
					<div class="flex items-start justify-between mb-4">
						<span class="text-3xl sm:text-4xl font-extrabold text-white/10 font-heading group-hover:text-orange-400/30 transition-colors">
							0{index + 1}
						</span>
						<span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/10 text-orange-300 border border-white/15">
							{artist.badge}
						</span>
					</div>

					<!-- Artist Name & Details -->
					<div>
						<h3 class="text-2xl font-black font-heading text-white group-hover:text-amber-300 transition-colors mb-1.5">
							{artist.name}
						</h3>
						<p class="text-xs sm:text-sm text-slate-400 font-medium">
							{artist.genre}
						</p>
					</div>

					<!-- Bottom line accent -->
					<div class="mt-5 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
						<span>⚡ Stage Vörabosc</span>
						<span class="text-orange-400">19.06.27</span>
					</div>
				</div>
			))}
		</div>

		<!-- Festival banner footer -->
		<div class="mt-8 p-4 sm:p-6 rounded-2xl glass-card border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center font-bold text-lg">
					🔊
				</div>
				<div>
					<h4 class="text-white font-bold text-sm sm:text-base">Música de 13:00 h a 00:00 h</h4>
					<p class="text-xs text-slate-400">Transicions non-stop entre escenaris i cabina de DJs.</p>
				</div>
			</div>
			<span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-300">
				#Vorabosc40
			</span>
		</div>
	</div>
</section>
