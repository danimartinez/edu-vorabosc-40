---
interface Artist {
	name: string;
	genre: string;
	image?: string;
	imagePosition?: string;
}

const artists: Artist[] = [
	{ name: "Cat4Rabbit", genre: "??????", image: "/images/artists/cat4rabbit.jpg" },
	{ name: "Nitro", genre: "House", image: "/images/artists/nitro.webp" },
	{ name: "Els Tets", genre: "Rumba", image: "/images/artists/els-tets.jpg", imagePosition: "object-top" },
	{ name: "Wagens", genre: "House", image: "/images/artists/wagens.jpg", imagePosition: "object-[center_15%]" },
	{ name: "Lacara.b", genre: "Salsa vinils", image: "/images/artists/lacarab.jpg" },
	{ name: "Vito Blasu", genre: "Electrònica orgànica", image: "/images/artists/vito-blasu.jpg", imagePosition: "object-top" },
	{ name: "DJ Saraswati", genre: "Electroswing i Grooves Remix", image: "/images/artists/dj-saraswati.jpg" },
];
---

<section id="musica" class="py-20 px-4 sm:px-6 lg:px-8 relative">
	<!-- Ambient background glow -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl h-96 bg-gradient-to-r from-amber-300/15 via-sky-300/15 to-amber-300/15 blur-3xl -z-10 pointer-events-none"></div>

	<div class="max-w-6xl mx-auto">
		<!-- Section Header -->
		<div class="text-center mb-14">
			<h2 class="text-3xl sm:text-5xl font-black text-slate-900 font-heading tracking-tight mb-4">
				<span class="text-gradient-sun-sky">Line-up</span>
			</h2>
			<p class="text-slate-600 max-w-xl mx-auto text-base sm:text-lg">
				11 hores consecutives de música, directes i DJ sets amb una selecció de luxe pensada per ballar sense descans.
			</p>
		</div>

		<!-- Festival Poster Grid (Centered Rows) -->
		<div class="flex flex-wrap justify-center gap-4 sm:gap-6">
			{artists.map((artist) => (
				<div class="glass-card glass-card-hover rounded-3xl p-4 sm:p-5 relative overflow-hidden group flex flex-col justify-between w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)]">
					
					<!-- Artist Image Container -->
					<div class="w-full aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-gradient-to-br from-slate-100 to-slate-200/80 border border-slate-200/80 relative flex items-center justify-center">
						{artist.image ? (
							<img
								src={artist.image}
								alt={artist.name}
								class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ${artist.imagePosition || 'object-center'}`}
							/>
						) : (
							<div class="flex flex-col items-center justify-center text-slate-400 gap-1.5">
								<span class="text-3xl opacity-75">
									🎧
								</span>
								<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
									Foto Artista
								</span>
							</div>
						)}
					</div>

					<!-- Artist Name & Genre -->
					<div class="flex flex-col flex-grow justify-end">
						<h3 class="text-xl sm:text-2xl font-black font-heading text-slate-900 group-hover:text-sky-700 transition-colors mb-1">
							{artist.name}
						</h3>
						{artist.genre && (
							<p class="text-xs sm:text-sm text-slate-500 font-semibold">
								{artist.genre}
							</p>
						)}
					</div>

				</div>
			))}
		</div>
	</div>
</section>
