---
import { EVENT_DATA } from '../consts';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#0a0b10]/80 border-b border-white/10 transition-all duration-300">
	<nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between">
		
		<!-- Brand Logo -->
		<a href="/edu-40" class="flex items-center gap-3 group">
			<img
				src="/logo/vorabosc-o-symbol.jpg"
				alt="Vörabosc Icon"
				class="w-10 h-10 rounded-xl object-contain shadow-md group-hover:scale-105 transition-transform bg-white/5 border border-white/10"
			/>
			<div class="flex flex-col">
				<span class="text-lg sm:text-xl font-black font-heading tracking-tight text-white group-hover:text-amber-300 transition-colors">
					VÖRABOSC <span class="text-orange-400">4.0</span>
				</span>
				<span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 -mt-1">
					Els 40 de l'Edu
				</span>
			</div>
		</a>

		<!-- Navigation Links -->
		<div class="hidden md:flex items-center gap-1.5 lg:gap-2">
			<a href="/edu-40#inici" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				Inici
			</a>
			<a href="/edu-40#informacio" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				La Invitació
			</a>
			<a href="/edu-40#historia" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				Història
			</a>
			<a href="/edu-40#cartell" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				Cartell
			</a>
			<a href="/edu-40#programa" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				Menú & Horaris
			</a>
			<a href="/edu-40#ubicacio-allotjament" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">
				Ubicació & Hotel
			</a>
		</div>

		<!-- Action Button / Date Badge -->
		<div class="flex items-center gap-3">
			<a
				href="/edu-40#inici"
				class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold bg-orange-500/15 border border-orange-500/30 text-orange-300 hover:bg-orange-500/25 transition-all"
			>
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				<span>19 · JUNY · 2027</span>
			</a>
			<a
				href="/edu-40#inici"
				class="inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-extrabold bg-gradient-to-r from-orange-500 to-amber-500 text-slate-950 hover:brightness-110 shadow-md transition-all cursor-pointer"
			>
				Save the Date
			</a>
		</div>

	</nav>
</header>

