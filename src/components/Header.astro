---
import { EVENT_DATA } from '../consts';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/85 border-b border-slate-200/80 transition-all duration-300 shadow-xs">
	<nav class="max-w-4xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-center">
		<!-- Centered Navigation Links & Tickets Button -->
		<div class="flex items-center justify-center gap-1 sm:gap-2 flex-wrap">
			<a href="/edu-40#inici" class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold text-slate-700 hover:text-sky-700 hover:bg-slate-100 transition-all">
				Inici
			</a>
			<span class="text-slate-300 text-xs hidden sm:inline">•</span>
			<a href="/edu-40#musica" class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold text-slate-700 hover:text-sky-700 hover:bg-slate-100 transition-all">
				Música
			</a>
			<span class="text-slate-300 text-xs hidden sm:inline">•</span>
			<a href="/edu-40#gastronomia" class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold text-slate-700 hover:text-sky-700 hover:bg-slate-100 transition-all">
				Gastronomia
			</a>
			<span class="text-slate-300 text-xs hidden sm:inline">•</span>
			<a href="/edu-40#historia" class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold text-slate-700 hover:text-sky-700 hover:bg-slate-100 transition-all">
				Història
			</a>
			<span class="text-slate-300 text-xs hidden sm:inline">•</span>
			<a href="/edu-40#ubicacio" class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold text-slate-700 hover:text-sky-700 hover:bg-slate-100 transition-all">
				Ubicació
			</a>

			<!-- Tickets Button CTA -->
			<a
				href="#tickets"
				class="ml-1 sm:ml-2.5 px-3.5 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950 shadow-xs hover:shadow-md transition-all active:scale-95 inline-flex items-center gap-1.5 border border-amber-300/80 cursor-pointer"
			>
				<span>🎟️</span>
				<span>Tickets</span>
			</a>
		</div>
	</nav>
</header>

