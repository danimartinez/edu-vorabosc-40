---
interface EventItem {
	time: string;
	title: string;
	subtitle: string;
	description: string;
	icon: string;
	highlight?: string;
	tag?: string;
}

const schedule: EventItem[] = [
	{
		time: "13:00 h",
		title: "El Vermut",
		subtitle: "Benvinguda & Arrencada",
		description: "Arribada a La Pèrgola, primeres copes, retrobades i aperitiu per escalfar l'ambient sota el sol d'estiu.",
		icon: "🍸",
		tag: "Obertura de Portes",
	},
	{
		time: "14:30 h",
		title: "El Gran Dinar: Els Arrossos",
		subtitle: "Equip Xefs: Sisco, Joni & Rita",
		description: "El plat fort del dia. Una paellada de campionat preparada amb amor i mestria per l'equip de mestres arrossers.",
		icon: "🥘",
		highlight: "Xefs d'honor: Sisco, Joni, Rita",
		tag: "Plat Principal",
	},
	{
		time: "18:00 h",
		title: "Berenar & Bufada de Pastís",
		subtitle: "Els 40 de l'Edu + Coca del Mossèn",
		description: "El moment culminant: bufem les 40 espelmes amb pastís d'aniversari i l'autèntica i mítica Coca del Mossèn.",
		icon: "🎂",
		highlight: "Moment 40 Anys ✨",
		tag: "Celebració",
	},
	{
		time: "21:00 h",
		title: "Sopar a la Fresca: Foodtrucks",
		subtitle: "Foodtrucks de La Pèrgola",
		description: "Recarrega energies sense parar la festa amb la selecció gastronòmica dels foodtrucks de La Pèrgola fins a mitjanit.",
		icon: "🍔",
		tag: "Festa Nocturna",
	},
];
---

<section id="programa" class="py-20 px-4 sm:px-6 lg:px-8 relative">
	<div class="max-w-4xl mx-auto">
		<!-- Section Header -->
		<div class="text-center mb-16">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest mb-4">
				<span>🍽️ Gastronomia & Horaris</span>
			</div>
			<h2 class="text-3xl sm:text-5xl font-extrabold text-white font-heading tracking-tight mb-4">
				El Menú del <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">Vörabosc</span>
			</h2>
			<p class="text-slate-300 max-w-xl mx-auto text-base sm:text-lg">
				Menjar bé i beure millor és llei de vida. Aquest és el recorregut gastronòmic que hem preparat de 13:00 a 00:00.
			</p>
		</div>

		<!-- Vertical Timeline -->
		<div class="relative">
			<!-- Central timeline line (desktop) / left line (mobile) -->
			<div class="absolute top-6 bottom-6 left-6 sm:left-1/2 -translate-x-1/2 w-0.5 bg-gradient-to-b from-orange-500 via-amber-500 to-rose-500 opacity-30"></div>

			<div class="space-y-8 sm:space-y-12">
				{schedule.map((item, idx) => {
					const isEven = idx % 2 === 0;
					return (
						<div class={`relative flex flex-col sm:flex-row items-start sm:items-center ${isEven ? 'sm:flex-row-reverse' : ''} gap-6 sm:gap-10`}>
							
							<!-- Timeline node icon -->
							<div class="absolute left-6 sm:left-1/2 -translate-x-1/2 w-12 h-12 rounded-full glass-card border-2 border-orange-500/50 flex items-center justify-center text-xl shadow-lg z-10 bg-slate-900">
								{item.icon}
							</div>

							<!-- Content card -->
							<div class="w-full sm:w-[calc(50%-2.5rem)] pl-16 sm:pl-0">
								<div class="glass-card glass-card-hover rounded-2xl p-6 sm:p-7 border border-white/10 relative overflow-hidden">
									
									<div class="flex items-center justify-between gap-2 mb-2">
										<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-orange-500/20 text-orange-400 border border-orange-500/30">
											⏰ {item.time}
										</span>
										{item.tag && (
											<span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
												{item.tag}
											</span>
										)}
									</div>

									<h3 class="text-xl sm:text-2xl font-bold font-heading text-white mb-1">
										{item.title}
									</h3>
									
									<p class="text-xs sm:text-sm font-semibold text-amber-300 mb-3">
										{item.subtitle}
									</p>

									<p class="text-sm text-slate-300 leading-relaxed">
										{item.description}
									</p>

									{item.highlight && (
										<div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-orange-300">
											<span>⭐️</span>
											<span>{item.highlight}</span>
										</div>
									)}
								</div>
							</div>

							<!-- Empty spacer for symmetry on large screens -->
							<div class="hidden sm:block sm:w-[calc(50%-2.5rem)]" />
						</div>
					);
				})}
			</div>
		</div>
	</div>
</section>
