---
import { EVENT_DATA } from '../consts';
---

<footer class="mt-20 border-t border-slate-200/80 bg-slate-50/80 py-14 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
	<div class="max-w-4xl mx-auto flex flex-col items-center justify-center space-y-6">
		
		<!-- Brand & Badge -->
		<div class="flex items-center gap-3">
			<img
				src="/logo/vorabosc-o-symbol.jpg"
				alt="Vörabosc"
				class="w-7 h-7 rounded-lg object-contain shadow-xs bg-white border border-slate-200"
			/>
			<span class="text-xl font-extrabold font-heading text-slate-900 tracking-tight">
				VÖRABOSC <span class="text-amber-500">4.0</span>
			</span>
		</div>

		<!-- Message -->
		<p class="text-slate-600 text-sm max-w-md leading-relaxed">
			Celebrant els 40 anys de l'Edu amb la millor companyia.<br />
			19 de Juny del 2027 · La Pèrgola (Carpes Vig Estiu, Vic).
		</p>

		<!-- Fast Links -->
		<div class="flex flex-wrap items-center justify-center gap-4 text-xs font-bold text-slate-500">
			<a href="/edu-40#inici" class="hover:text-sky-600 transition-colors">Inici</a>
			<span>•</span>
			<a href="/edu-40#musica" class="hover:text-sky-600 transition-colors">Música</a>
			<span>•</span>
			<a href="/edu-40#gastronomia" class="hover:text-sky-600 transition-colors">Gastronomia</a>
			<span>•</span>
			<a href="/edu-40#historia" class="hover:text-sky-600 transition-colors">Història</a>
			<span>•</span>
			<a href="/edu-40#ubicacio" class="hover:text-sky-600 transition-colors">Ubicació</a>
		</div>

		<!-- Copyright / Sign-off -->
		<div class="pt-6 border-t border-slate-200/60 w-full flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-2">
			<span>© 2027 Vörabosc 4.0 — Fet amb ❤️ per als 40 de l'Edu.</span>
			<span>#Vorabosc40 · 19.06.2027</span>
		</div>

	</div>
</footer>
