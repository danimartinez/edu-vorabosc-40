---
import { EVENT_DATA } from '../consts';
---

<footer class="mt-20 border-t border-slate-200/80 bg-slate-50/80 py-10 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
	<div class="max-w-4xl mx-auto flex flex-col items-center justify-center space-y-4">
		
		<!-- Brand & Badge -->
		<div class="flex items-center gap-3">
			<img
				src="/logo/vorabosc-o-symbol.jpg"
				alt="Vörabosc"
				class="w-7 h-7 rounded-lg object-contain shadow-xs bg-white border border-slate-200"
			/>
			<span class="text-lg font-extrabold font-heading text-slate-900 tracking-tight">
				VÖRABOSC <span class="text-amber-500">4.0</span>
			</span>
		</div>

		<!-- Copyright / Sign-off -->
		<div class="pt-4 border-t border-slate-200/60 w-full flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-2">
			<span>© 2027 Vörabosc 4.0 — Fet amb ❤️ per als 40 de l'Edu.</span>
			<span>#Vorabosc40 · 19.06.2027</span>
		</div>

	</div>
</footer>
