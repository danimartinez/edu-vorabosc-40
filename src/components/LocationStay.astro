---
import { EVENT_DATA } from '../consts';
---

<section id="ubicacio" class="py-20 px-4 sm:px-6 lg:px-8 relative">
	<div class="max-w-5xl mx-auto">
		
		<!-- Section Header -->
		<div class="text-center mb-16">
			<h2 class="text-4xl sm:text-6xl font-bold text-slate-900 font-heading tracking-wide mb-4">
				Com arribar i <span class="text-gradient-sun-sky">l'Espai</span>
			</h2>
			<p class="text-slate-600 max-w-xl mx-auto text-base sm:text-lg">
				Tot el que necessites saber per arribar a temps i gaudir de la festa a La Pèrgola.
			</p>
		</div>

		<!-- Two-column grid: Location & Venue Photo -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
			
			<!-- Card 1: Venue / La Pèrgola -->
			<div class="glass-card glass-card-hover rounded-3xl p-8 flex flex-col justify-between relative overflow-hidden">
				<div class="absolute top-0 right-0 w-36 h-36 bg-amber-400/10 rounded-full blur-2xl pointer-events-none"></div>

				<div>
					<div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl mb-6 shadow-xs">
						🎪
					</div>

					<span class="text-xs font-bold uppercase tracking-widest text-amber-700">El Lloc de la Festa</span>
					<h3 class="text-3xl sm:text-4xl font-heading tracking-wide text-slate-900 mt-1 mb-2">
						La Pèrgola
					</h3>
					<p class="text-sky-700 font-bold text-sm mb-4">
						Carpes Vig Estiu · Vic (Barcelona)
					</p>

					<p class="text-slate-600 text-sm leading-relaxed mb-6">
						Un espai a l'aire lliure, ampli i acollidor per passar del vermut del migdia al ball sota les estrelles.
					</p>

					<ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 mb-8 font-medium">
						<li class="flex items-center gap-2">
							<span class="text-emerald-600 font-bold">✓</span>
							<span><strong>Horari:</strong> 13:00 h a 00:00 h</span>
						</li>
						<li class="flex items-center gap-2">
							<span class="text-emerald-600 font-bold">✓</span>
							<span><strong>Aparcament:</strong> Zona d'aparcament habilitada al recinte</span>
						</li>
						<li class="flex items-center gap-2">
							<span class="text-emerald-600 font-bold">✓</span>
							<span><strong>Dress Code:</strong> Festival estiuenc & calçat còmode per ballar</span>
						</li>
					</ul>
				</div>

				<a
					href={EVENT_DATA.mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm transition-all text-center group shadow-md"
				>
					<span>Obrir a Google Maps</span>
					<svg class="w-4 h-4 text-amber-400 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
					</svg>
				</a>
			</div>

			<!-- Card 2: Venue Photo / Carpes Vig Estiu -->
			<div class="glass-card glass-card-hover rounded-3xl p-3 sm:p-4 relative overflow-hidden flex flex-col group min-h-[350px]">
				<div class="relative w-full h-full min-h-[300px] rounded-2xl overflow-hidden shadow-xs">
					<img
						src="/images/la-pergola.jpg"
						alt="Carpes Vig Estiu - La Pèrgola"
						class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-700"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent flex items-end p-5 sm:p-6">
						<span class="text-white text-xs sm:text-sm font-bold bg-slate-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20 flex items-center gap-1.5 shadow-md">
							<span>📍</span>
							<span>Carpes Vig Estiu · La Pèrgola</span>
						</span>
					</div>
				</div>
			</div>

		</div>

		<!-- FOMO Banner Reminder -->
		<div class="mt-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-amber-50 via-sky-50 to-amber-50 border border-amber-200 text-center relative overflow-hidden shadow-xs">
			<div class="max-w-2xl mx-auto">
				<span class="text-2xl mb-2 block">🔥</span>
				<h4 class="text-xl sm:text-2xl font-bold font-body text-slate-900 mb-2">
					"Guarda la data que el FOMO et pot arribar a durar 40 anys"
				</h4>
				<p class="text-slate-600 text-sm sm:text-base">
					No cada dia es canvia de dècada. Ens veiem el 19 de Juny del 2027 a La Pèrgola!
				</p>
			</div>
		</div>

	</div>
</section>
